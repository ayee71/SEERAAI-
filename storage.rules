rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (request.auth.token.admin == true || request.auth.token.email == 'ayeledha@gmail.com');
    }

    // Scoped storage path: legal_docs/{institutionId}/{userId}/{fileName}
    match /legal_docs/{institutionId}/{userId}/{allPaths=**} {
      
      // Ownership check: Users can read and write their own files
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      
      // Institutional isolation: 
      // Admins, Judges, and Registrars of the same institution can read documents
      allow read: if isSignedIn() && 
                    request.auth.token.institutionId == institutionId && 
                    (request.auth.token.role in ['court_admin', 'judge', 'registrar'] || 
                     request.auth.token.courtRole in ['court_admin', 'judge', 'registrar']);
      
      // Global Admin override
      allow read, write: if isAdmin();
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
