rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // SEERAAI PRO - CANDIDATE PRODUCTION FIRESTORE SECURITY RULES
    // Target Project ID : leafy-rush-xvd6f
    // Target Database ID: ai-studio-seeraaitrilingua-18431532-f42a-4a5a-b5b1-c3c0e6b05478
    // Principle         : Deny-by-default, Verified Custom Claims, Tenant Isolation
    // STATUS            : CANDIDATE ONLY - DO NOT DEPLOY WITHOUT HUMAN APPROVAL
    // =========================================================================

    // ==========================================
    // 1. GLOBAL AUTHENTICATION & TENANT HELPERS
    // ==========================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isNonAnonymous() {
      return isSignedIn() &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Strict email verification check: never treats phone or anonymous auth as verified email
    function isEmailVerified() {
      return isNonAnonymous() &&
        request.auth.token.email_verified == true &&
        request.auth.token.firebase.sign_in_provider != 'phone';
    }

    function isOwner(userId) {
      return isNonAnonymous() && request.auth.uid == userId;
    }

    // Strict claim-based global administrator check (no hardcoded unverified emails)
    function isAdmin() {
      return isEmailVerified() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'superadmin'
      );
    }

    function effectiveCourtRole() {
      return request.auth.token.courtRole is string
        ? request.auth.token.courtRole
        : (request.auth.token.role is string ? request.auth.token.role : '');
    }

    function isLegalRepositoryManager() {
      return isEmailVerified() && (
        isAdmin() ||
        request.auth.token.legalContentManager == true ||
        effectiveCourtRole() in ['judge', 'legal_expert', 'court_admin']
      );
    }

    function hasInstitution() {
      return isEmailVerified() &&
        request.auth.token.institutionId is string &&
        request.auth.token.institutionId.size() > 0 &&
        request.auth.token.institutionId.size() <= 128;
    }

    function belongsToInstitution(institutionId) {
      return hasInstitution() && request.auth.token.institutionId == institutionId;
    }

    function hasCourtRole() {
      return isEmailVerified() && (
        isAdmin() ||
        (hasInstitution() && effectiveCourtRole() in [
          'judge', 'assistant_judge', 'registrar', 'legal_expert', 'auditor', 'court_admin', 'clerk'
        ])
      );
    }

    function isInstitutionStaff(institutionId) {
      return isAdmin() || (
        belongsToInstitution(institutionId) &&
        effectiveCourtRole() in [
          'judge', 'assistant_judge', 'registrar', 'legal_expert', 'auditor', 'court_admin', 'clerk'
        ]
      );
    }

    function isCourtAdminOf(institutionId) {
      return isAdmin() || (
        belongsToInstitution(institutionId) &&
        effectiveCourtRole() == 'court_admin'
      );
    }

    function canEditCasesIn(institutionId) {
      return isAdmin() || (
        belongsToInstitution(institutionId) &&
        effectiveCourtRole() in ['judge', 'assistant_judge', 'registrar', 'court_admin']
      );
    }

    function parentCaseInstitution(caseId) {
      return get(/databases/$(database)/documents/cases/$(caseId)).data.institutionId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function matchesExistingOwner() {
      return (
        ('userId' in existing() && existing().userId == request.auth.uid) ||
        ('ownerId' in existing() && existing().ownerId == request.auth.uid)
      );
    }

    function matchesIncomingOwner() {
      return (
        ('userId' in incoming() && incoming().userId == request.auth.uid) ||
        ('ownerId' in incoming() && incoming().ownerId == request.auth.uid)
      );
    }

    function hasImmutableOwner() {
      return (
        (!('userId' in existing()) || incoming().userId == existing().userId) &&
        (!('ownerId' in existing()) || incoming().ownerId == existing().ownerId)
      );
    }

    // Prevent multi-MB base64 file payloads inside Firestore documents (files belong in Storage)
    function hasNoOversizedDataUrl(data) {
      return !('dataUrl' in data) || !(data.dataUrl is string) || data.dataUrl.size() <= 65536;
    }

    // ==========================================
    // 2. ENTITY VALIDATORS
    // ==========================================

    function isValidPayment(data) {
      return data.keys().hasAll(['userId', 'planId', 'amountETB', 'transactionReference', 'status', 'createdAt']) &&
             data.keys().hasOnly([
               'userId', 'planId', 'amountETB', 'transactionReference', 'status',
               'createdAt', 'payerPhone', 'payerName', 'notes', 'updatedAt', 'paymentMethod'
             ]) &&
             data.userId == request.auth.uid &&
             data.status == 'pending' &&
             data.amountETB is number && data.amountETB > 0;
    }

    // ==========================================
    // 3. USER IDENTITY & PROFILES
    // ==========================================

    match /usernameIndex/{username} {
      allow read: if isNonAnonymous();
      allow write: if false; // Backend Admin SDK only
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) &&
        incoming().uid == userId &&
        (!('role' in incoming()) || incoming().role == 'user') &&
        !('admin' in incoming()) &&
        !('courtRole' in incoming()) &&
        !('permissions' in incoming()) &&
        (!('subscriptionTier' in incoming()) || incoming().subscriptionTier == 'free') &&
        (!('courtId' in incoming()) || incoming().courtId == null || incoming().courtId == '') &&
        (!('institutionId' in incoming()) || incoming().institutionId == null || incoming().institutionId == '');
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !incoming().diff(existing()).affectedKeys().hasAny([
          'uid', 'role', 'admin', 'courtRole', 'permissions',
          'subscriptionTier', 'courtId', 'institutionId', 'status', 'accountStatus', 'verified'
        ])
      );
      allow delete: if isAdmin();

      match /webauthn_credentials/{credId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /saved_citations/{citId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // ==========================================
    // 4. PUBLIC LEGAL KNOWLEDGE REPOSITORIES
    // ==========================================

    match /legislation_repository/{id} {
      allow read: if true;
      allow write: if isLegalRepositoryManager();
    }

    match /legalEnactments/{id} {
      allow read: if true;
      allow write: if isLegalRepositoryManager();
    }

    match /cassationDecisions/{id} {
      allow read: if true;
      allow write: if isLegalRepositoryManager();
    }

    match /cassation_decisions/{id} {
      allow read: if true;
      allow write: if isLegalRepositoryManager();
    }

    match /legal_sources/{id} {
      allow read: if true;
      allow write: if isLegalRepositoryManager();
    }

    match /legal_ingestion_jobs/{id} {
      allow read, write: if isLegalRepositoryManager();
    }

    match /vector_chunks/{id} {
      allow read: if isNonAnonymous() && (
        !('metadata' in resource.data) ||
        !('institutionId' in resource.data.metadata) ||
        resource.data.metadata.institutionId == null ||
        isInstitutionStaff(resource.data.metadata.institutionId)
      );
      allow write: if isAdmin();
    }

    match /social_legal_repository/{id} {
      allow read: if true;
      allow write: if isLegalRepositoryManager();
    }

    match /legal_qna_repository/{id} {
      allow read: if true;
      allow create: if isNonAnonymous() &&
        (!('userId' in incoming()) || incoming().userId == request.auth.uid) &&
        (!('isVerifiedByExpert' in incoming()) || incoming().isVerifiedByExpert == false);
      allow update, delete: if isLegalRepositoryManager();
    }

    match /owner_private_qna/{id} {
      allow read, write: if isAdmin();
    }

    match /legalDocuments/{id} {
      allow read: if (resource.data.status == 'PUBLISHED') || isLegalRepositoryManager();
      allow write: if isLegalRepositoryManager();

      match /textChunks/{chunkId} {
        allow read: if (get(/databases/$(database)/documents/legalDocuments/$(id)).data.status == 'PUBLISHED') || isLegalRepositoryManager();
        allow write: if isLegalRepositoryManager();
      }

      match /versions/{versionId} {
        allow read: if (get(/databases/$(database)/documents/legalDocuments/$(id)).data.status == 'PUBLISHED') || isLegalRepositoryManager();
        allow write: if isLegalRepositoryManager();
      }

      match /reviewHistory/{reviewId} {
        allow read: if isLegalRepositoryManager();
        allow write: if isLegalRepositoryManager();
      }
    }

    match /telegram_legal_documents/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isLegalRepositoryManager();
    }

    // ==========================================
    // 5. TELEGRAM OPERATIONAL COLLECTIONS
    // ==========================================

    match /telegram_channel_feed/{docId} {
      allow read: if true;
      allow write: if isLegalRepositoryManager();
    }

    match /telegram_posts/{docId} {
      allow read: if true;
      allow write: if isLegalRepositoryManager();
    }

    // Operational logs, subscriber PII, poll answers, and user stats: Backend Admin SDK & Admins only
    match /telegram_logs/{id} {
      allow read, write: if isAdmin();
    }
    match /telegram_polls/{allPaths=**} {
      allow read, write: if isAdmin();
    }
    match /telegram_channels/{allPaths=**} {
      allow read, write: if isAdmin();
    }
    match /telegram_archive/{allPaths=**} {
      allow read, write: if isAdmin();
    }
    match /telegram_messages/{allPaths=**} {
      allow read, write: if isAdmin();
    }
    match /telegram_subscribers/{allPaths=**} {
      allow read, write: if isAdmin();
    }
    match /telegram_user_stats/{allPaths=**} {
      allow read, write: if isAdmin();
    }
    match /telegram_poll_results/{allPaths=**} {
      allow read, write: if isAdmin();
    }
    match /telegram_briefing_logs/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // ==========================================
    // 6. ANALYTICS, FEEDBACK & ADMINISTRATIVE AUDITS
    // ==========================================

    match /site_analytics/{docId} {
      allow read, write: if isAdmin();
    }

    match /legal_ai_audit/{docId} {
      allow create: if isNonAnonymous() && incoming().uid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /legalAuditLogs/{id} {
      allow read, write: if isAdmin();
    }

    match /legal_sources_audit/{id} {
      allow read: if isLegalRepositoryManager();
      allow write: if isAdmin();
    }

    match /quality_audits/{auditId} {
      allow read, create, update: if isAdmin() || (
        isEmailVerified() && effectiveCourtRole() in ['chief_judge', 'it_auditor', 'auditor', 'legal_expert']
      );
      allow delete: if isAdmin();

      match /{allPaths=**} {
        allow read, create, update: if isAdmin() || (
          isEmailVerified() && effectiveCourtRole() in ['chief_judge', 'it_auditor', 'auditor', 'legal_expert']
        );
        allow delete: if isAdmin();
      }
    }

    match /feedback_messages/{id} {
      allow create: if isNonAnonymous() && (!('userId' in incoming()) || incoming().userId == request.auth.uid);
      allow read, update, delete: if isAdmin();
    }

    match /analytics_events/{id} {
      allow create: if isNonAnonymous() && (!('userId' in incoming()) || incoming().userId == request.auth.uid);
      allow read, update, delete: if isAdmin();
    }

    match /vector_feedback/{id} {
      allow create: if isNonAnonymous() && (!('userId' in incoming()) || incoming().userId == request.auth.uid);
      allow read, update, delete: if isAdmin();
    }

    match /user_feedback/{id} {
      allow create: if isNonAnonymous() && incoming().userId == request.auth.uid;
      allow read: if isNonAnonymous() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /audit_logs/{id} {
      allow read: if isAdmin() || (
        isNonAnonymous() && resource.data.userId == request.auth.uid
      ) || (
        'institutionId' in resource.data &&
        resource.data.institutionId is string &&
        isInstitutionStaff(resource.data.institutionId) &&
        effectiveCourtRole() in ['judge', 'auditor', 'court_admin']
      );
      allow create: if isNonAnonymous() && incoming().userId == request.auth.uid;
      allow update, delete: if false; // Append-only immutable audit trail
    }

    match /admin_activity_logs/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /admin_activity_logs_archived/{id} {
      allow read, write: if isAdmin();
    }

    match /admin_logs/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /auth_logs/{id} {
      allow read: if isAdmin() || (isNonAnonymous() && resource.data.userId == request.auth.uid);
      allow create: if isNonAnonymous() && incoming().userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /system_config/{id} {
      allow read: if isNonAnonymous();
      allow write: if isAdmin();
    }

    match /verifications/{id} {
      allow read, write: if isAdmin();
    }

    match /test/{id} {
      allow read, write: if false;
    }

    // ==========================================
    // 7. USER-OWNED PERSONAL WORKSPACES & COLLABORATION
    // ==========================================

    match /user_content/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /objection_templates/{id} {
      allow read: if isNonAnonymous() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() && incoming().userId == request.auth.uid;
      allow update: if isOwner(existing().userId) && incoming().userId == existing().userId;
      allow delete: if isOwner(existing().userId) || isAdmin();
    }

    match /court_sessions/{id} {
      allow read: if isNonAnonymous() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() && incoming().userId == request.auth.uid;
      allow update: if isOwner(existing().userId) && incoming().userId == existing().userId;
      allow delete: if isOwner(existing().userId) || isAdmin();
    }

    match /annotations/{id} {
      allow read: if isNonAnonymous() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() && incoming().userId == request.auth.uid;
      allow update: if isOwner(existing().userId) && incoming().userId == existing().userId;
      allow delete: if isOwner(existing().userId) || isAdmin();
    }

    match /dossier_audits/{id} {
      allow read: if isNonAnonymous() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /document_drafts/{id} {
      allow read: if (resource.data.isPublic == true) ||
        (isNonAnonymous() && (resource.data.userId == request.auth.uid || resource.data.ownerId == request.auth.uid || isAdmin()));
      allow create: if isEmailVerified() && (matchesIncomingOwner() || isAdmin()) && hasNoOversizedDataUrl(incoming());
      allow update: if isNonAnonymous() && ((matchesExistingOwner() && hasImmutableOwner()) || isAdmin()) && hasNoOversizedDataUrl(incoming());
      allow delete: if isNonAnonymous() && (matchesExistingOwner() || isAdmin());
    }

    match /user_documents/{id} {
      allow get, list: if isNonAnonymous() && (resource.data.userId == request.auth.uid || resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() && matchesIncomingOwner() && hasNoOversizedDataUrl(incoming());
      allow update: if isNonAnonymous() && matchesExistingOwner() && hasImmutableOwner() && hasNoOversizedDataUrl(incoming());
      allow delete: if isNonAnonymous() && (matchesExistingOwner() || isAdmin());
    }

    match /shared_drafts/{id} {
      allow read: if isNonAnonymous() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.sharedWith is list && request.auth.uid in resource.data.sharedWith) ||
        isAdmin()
      );
      allow create: if isEmailVerified() && incoming().ownerId == request.auth.uid;
      allow update: if isNonAnonymous() && existing().ownerId == request.auth.uid && incoming().ownerId == existing().ownerId;
      allow delete: if isNonAnonymous() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /shared_folders/{id} {
      allow read: if isNonAnonymous() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.sharedWith is list && request.auth.uid in resource.data.sharedWith) ||
        isAdmin()
      );
      allow create: if isEmailVerified() && incoming().ownerId == request.auth.uid;
      allow update: if isNonAnonymous() && existing().ownerId == request.auth.uid && incoming().ownerId == existing().ownerId;
      allow delete: if isNonAnonymous() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /collaboration_invites/{id} {
      allow read: if isNonAnonymous() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.recipientUid == request.auth.uid ||
        resource.data.recipientEmail == request.auth.token.email ||
        isAdmin()
      );
      allow create: if isEmailVerified() && incoming().senderUid == request.auth.uid;
      allow update: if isNonAnonymous() && (
        existing().senderUid == request.auth.uid ||
        existing().recipientUid == request.auth.uid ||
        existing().recipientEmail == request.auth.token.email ||
        isAdmin()
      ) && incoming().senderUid == existing().senderUid;
      allow delete: if isNonAnonymous() && (existing().senderUid == request.auth.uid || isAdmin());
    }

    match /discussions/{id} {
      allow read: if true;
      allow create: if isEmailVerified() && matchesIncomingOwner();
      allow update: if isNonAnonymous() && (matchesExistingOwner() || existing().authorId == request.auth.uid || isAdmin()) && hasImmutableOwner();
      allow delete: if isNonAnonymous() && (matchesExistingOwner() || existing().authorId == request.auth.uid || isAdmin());
    }

    match /practice_cases/{caseId} {
      allow read: if isNonAnonymous() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() && incoming().userId == request.auth.uid;
      allow update: if isNonAnonymous() && ((existing().userId == request.auth.uid && incoming().userId == existing().userId) || isAdmin());
      allow delete: if isNonAnonymous() && (existing().userId == request.auth.uid || isAdmin());
    }

    // ==========================================
    // 8. PAYMENTS & SUBSCRIPTIONS
    // ==========================================

    match /payment_transactions/{id} {
      allow read: if isNonAnonymous() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() && isValidPayment(incoming());
      allow update, delete: if isAdmin();
    }

    match /airtime_requests/{id} {
      allow read: if isNonAnonymous() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() && incoming().userId == request.auth.uid && (!('status' in incoming()) || incoming().status == 'pending');
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // 9. INSTITUTIONAL TENANT ISOLATION & JUDICIAL DOCKETS
    // ==========================================

    match /court_branding/{institutionId} {
      allow read: if true; // Public court name & logo URL only (no secrets/passcodes)
      allow create, update: if isCourtAdminOf(institutionId);
      allow delete: if isAdmin();
    }

    match /court_institutions/{id} {
      allow get, list: if isInstitutionStaff(id) || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isCourtAdminOf(id) &&
        !incoming().diff(existing()).affectedKeys().hasAny([
          'id', 'status', 'institutionStatus', 'approvedBy', 'adminUid', 'accessCode'
        ])
      );
    }

    match /court_users/{id} {
      allow get: if isOwner(id) || isCourtAdminOf(resource.data.institutionId);
      allow list: if isAdmin() || (
        hasInstitution() &&
        effectiveCourtRole() == 'court_admin' &&
        resource.data.institutionId == request.auth.token.institutionId
      );
      allow create: if isAdmin() || (
        hasInstitution() &&
        incoming().institutionId is string &&
        isCourtAdminOf(incoming().institutionId) &&
        !(incoming().role in ['superadmin', 'admin', 'court_admin'])
      );
      allow update: if isAdmin() || (
        isCourtAdminOf(existing().institutionId) &&
        incoming().institutionId == existing().institutionId &&
        incoming().role == existing().role &&
        !(incoming().role in ['superadmin', 'admin'])
      );
      allow delete: if isAdmin();
    }

    match /court_access_requests/{id} {
      allow create: if isNonAnonymous() && incoming().userId == request.auth.uid && incoming().status == 'pending';
      allow read: if isAdmin() ||
        (isNonAnonymous() && resource.data.userId == request.auth.uid) ||
        (hasInstitution() && effectiveCourtRole() == 'court_admin' && resource.data.institutionId == request.auth.token.institutionId);
      allow update: if isAdmin() || (
        'institutionId' in existing() && isCourtAdminOf(existing().institutionId)
      );
      allow delete: if isAdmin();
    }

    match /court_staff_requests/{id} {
      allow create: if isNonAnonymous() &&
        (!('userId' in incoming()) || incoming().userId == request.auth.uid) &&
        incoming().status == 'pending';
      allow read: if isAdmin() ||
        (isNonAnonymous() && 'userId' in resource.data && resource.data.userId == request.auth.uid) ||
        (hasInstitution() && effectiveCourtRole() == 'court_admin' && resource.data.institutionId == request.auth.token.institutionId);
      allow update: if isAdmin() || isCourtAdminOf(existing().institutionId);
      allow delete: if isAdmin();
    }

    match /court_personnel_mappings/{id} {
      allow read: if isAdmin() || (hasInstitution() && resource.data.woredaCourtId == request.auth.token.institutionId);
      allow create: if isAdmin() || isCourtAdminOf(incoming().woredaCourtId);
      allow update: if isAdmin() || (isCourtAdminOf(existing().woredaCourtId) && incoming().woredaCourtId == existing().woredaCourtId);
      allow delete: if isAdmin();
    }

    match /institutions/{institutionId} {
      allow get, list: if isInstitutionStaff(institutionId);
      allow create, delete: if isAdmin();
      allow update: if isCourtAdminOf(institutionId) &&
        (!('id' in existing()) || incoming().id == existing().id);

      match /courtDocuments/{docId} {
        allow get, list: if isInstitutionStaff(institutionId);
        allow create: if canEditCasesIn(institutionId) &&
          incoming().institutionId == institutionId &&
          incoming().createdBy == request.auth.uid &&
          hasNoOversizedDataUrl(incoming());
        allow update: if canEditCasesIn(institutionId) &&
          existing().institutionId == institutionId &&
          incoming().institutionId == existing().institutionId &&
          (!('createdBy' in existing()) || incoming().createdBy == existing().createdBy) &&
          hasNoOversizedDataUrl(incoming());
        allow delete: if isCourtAdminOf(institutionId);
      }

      match /auditLogs/{logId} {
        allow get, list: if isAdmin() || (
          belongsToInstitution(institutionId) &&
          effectiveCourtRole() in ['judge', 'auditor', 'court_admin']
        );
        allow create: if isInstitutionStaff(institutionId) && incoming().actorUid == request.auth.uid;
        allow update, delete: if false; // Immutable audit log
      }
    }

    match /court_documents/{docId} {
      allow get, list: if (resource.data.isPublic == true) ||
        isInstitutionStaff(resource.data.institutionId);
      allow create: if canEditCasesIn(incoming().institutionId) &&
        incoming().institutionId is string &&
        incoming().institutionId.size() > 0 &&
        (!('createdBy' in incoming()) || incoming().createdBy == request.auth.uid) &&
        hasNoOversizedDataUrl(incoming());
      allow update: if canEditCasesIn(existing().institutionId) &&
        incoming().institutionId == existing().institutionId &&
        (!('createdBy' in existing()) || incoming().createdBy == existing().createdBy) &&
        hasNoOversizedDataUrl(incoming());
      allow delete: if isCourtAdminOf(existing().institutionId);
    }

    match /cases/{caseId} {
      allow get, list: if hasCourtRole() && (
        resource.data.isPublic == true ||
        belongsToInstitution(resource.data.institutionId) ||
        isAdmin()
      );
      allow create: if canEditCasesIn(incoming().institutionId) &&
        incoming().institutionId is string &&
        incoming().institutionId.size() > 0;
      allow update: if canEditCasesIn(existing().institutionId) &&
        incoming().institutionId == existing().institutionId;
      allow delete: if isAdmin();

      match /activity_logs/{logId} {
        allow read: if isInstitutionStaff(parentCaseInstitution(caseId));
        allow create: if isInstitutionStaff(parentCaseInstitution(caseId));
        allow update, delete: if false;
      }

      match /audio_recordings/{recId} {
        allow read: if isInstitutionStaff(parentCaseInstitution(caseId));
        allow create, update: if canEditCasesIn(parentCaseInstitution(caseId));
        allow delete: if isCourtAdminOf(parentCaseInstitution(caseId));
      }

      match /physical_evidence/{evidenceId} {
        allow read: if isInstitutionStaff(parentCaseInstitution(caseId));
        allow create, update: if canEditCasesIn(parentCaseInstitution(caseId));
        allow delete: if isCourtAdminOf(parentCaseInstitution(caseId));
      }

      match /witness_statements/{stmtId} {
        allow read: if isInstitutionStaff(parentCaseInstitution(caseId));
        allow create, update: if canEditCasesIn(parentCaseInstitution(caseId));
        allow delete: if isCourtAdminOf(parentCaseInstitution(caseId));
      }

      match /courtroom_layout/{layoutId} {
        allow read: if isInstitutionStaff(parentCaseInstitution(caseId));
        allow create, update: if canEditCasesIn(parentCaseInstitution(caseId));
        allow delete: if isCourtAdminOf(parentCaseInstitution(caseId));
      }
    }

    match /witness_schedules/{id} {
      allow read: if isInstitutionStaff(resource.data.institutionId);
      allow create: if canEditCasesIn(incoming().institutionId) &&
        incoming().institutionId is string &&
        incoming().institutionId.size() > 0;
      allow update: if canEditCasesIn(existing().institutionId) &&
        incoming().institutionId == existing().institutionId;
      allow delete: if isCourtAdminOf(existing().institutionId);
    }

    match /witness_statements/{stmtId} {
      allow read: if isInstitutionStaff(resource.data.institutionId);
      allow create: if canEditCasesIn(incoming().institutionId) &&
        incoming().institutionId is string &&
        incoming().institutionId.size() > 0;
      allow update: if canEditCasesIn(existing().institutionId) &&
        incoming().institutionId == existing().institutionId;
      allow delete: if isCourtAdminOf(existing().institutionId);
    }

    match /court_audio_recordings/{recId} {
      allow read: if isInstitutionStaff(resource.data.institutionId);
      allow create: if canEditCasesIn(incoming().institutionId) &&
        incoming().institutionId is string &&
        incoming().institutionId.size() > 0;
      allow update: if canEditCasesIn(existing().institutionId) &&
        incoming().institutionId == existing().institutionId;
      allow delete: if isCourtAdminOf(existing().institutionId);
    }

    match /case_milestones/{id} {
      allow read: if isInstitutionStaff(resource.data.institutionId);
      allow create: if canEditCasesIn(incoming().institutionId) &&
        incoming().institutionId is string &&
        incoming().institutionId.size() > 0;
      allow update: if canEditCasesIn(existing().institutionId) &&
        incoming().institutionId == existing().institutionId;
      allow delete: if isCourtAdminOf(existing().institutionId);
    }

    match /courtroom_sessions/{id} {
      allow read: if resource.data.isPublic == true || isInstitutionStaff(resource.data.institutionId);
      allow create: if canEditCasesIn(incoming().institutionId) &&
        incoming().institutionId is string &&
        incoming().institutionId.size() > 0;
      allow update: if canEditCasesIn(existing().institutionId) &&
        incoming().institutionId == existing().institutionId;
      allow delete: if isCourtAdminOf(existing().institutionId);
    }

    match /court_templates/{id} {
      allow read: if resource.data.isPublic == true || isInstitutionStaff(resource.data.institutionId);
      allow create: if canEditCasesIn(incoming().institutionId) &&
        incoming().institutionId is string &&
        incoming().institutionId.size() > 0;
      allow update: if canEditCasesIn(existing().institutionId) &&
        incoming().institutionId == existing().institutionId;
      allow delete: if isCourtAdminOf(existing().institutionId);
    }

    match /court_notifications/{id} {
      allow read: if isNonAnonymous() && (
        resource.data.recipientUid == request.auth.uid ||
        isInstitutionStaff(resource.data.institutionId)
      );
      allow create: if isAdmin() || (
        canEditCasesIn(incoming().institutionId) &&
        incoming().institutionId is string &&
        incoming().institutionId.size() > 0
      );
      allow update: if isNonAnonymous() && (
        existing().recipientUid == request.auth.uid ||
        canEditCasesIn(existing().institutionId)
      ) && (!('institutionId' in existing()) || incoming().institutionId == existing().institutionId);
      allow delete: if isAdmin();
    }

    // ==========================================
    // 10. STRICT DEFAULT DENY (NO WILDCARD ADMIN OVERRIDE)
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
