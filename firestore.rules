rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // 1. GLOBAL HELPERS
    // ==========================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true || 
        request.auth.token.firebase.sign_in_provider == 'phone' || 
        request.auth.token.firebase.sign_in_provider == 'anonymous' ||
        request.auth.token.email == 'ayeledha@gmail.com'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'ayeledha@gmail.com' ||
        request.auth.token.email == 'ayeledha@saiethio.com' ||
        request.auth.token.email == 'ayele@saiethio.com'
      );
    }

    function isLegalRepositoryManager() {
      return signedIn() && (
        isAdmin() ||
        request.auth.token.legalContentManager == true
      );
    }

    function hasCourtRole() {
      return signedIn() && (
        isAdmin() ||
        request.auth.token.role in ['judge', 'assistant_judge', 'registrar', 'legal_expert', 'auditor'] ||
        request.auth.token.courtRole in ['judge', 'assistant_judge', 'registrar', 'legal_expert', 'auditor']
      );
    }

    function canEditCases() {
      return signedIn() && (
        isAdmin() ||
        request.auth.token.role in ['judge', 'assistant_judge', 'registrar'] ||
        request.auth.token.courtRole in ['judge', 'assistant_judge', 'registrar']
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Security Starter: Username Registry Protection
    match /usernameIndex/{username} {
      allow read: if isSignedIn();
      allow write: if false; // Only via backend Admin SDK
    }

    // ==========================================
    // 2. ENTITY VALIDATORS
    // ==========================================

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'visitorName', 'courtId']) &&
             data.keys().hasOnly(['uid', 'email', 'visitorName', 'courtId', 'createdAt', 'updatedAt', 'phone', 'photoURL', 'role', 'subscriptionTier', 'languagePreference']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.visitorName is string && data.visitorName.size() <= 100 &&
             data.courtId is string && data.courtId.size() <= 64;
    }

    function isValidPayment(data) {
      return data.keys().hasAll(['userId', 'planId', 'amountETB', 'transactionReference', 'status', 'createdAt']) &&
             data.keys().hasOnly(['userId', 'planId', 'amountETB', 'transactionReference', 'status', 'createdAt', 'payerPhone', 'payerName', 'notes', 'updatedAt']) &&
             data.userId == request.auth.uid &&
             data.status in ['pending', 'completed', 'rejected'] &&
             data.amountETB is number;
    }

    // ==========================================
    // 3. COLLECTION MATCH BLOCKS
    // ==========================================

    // User Profiles Isolation
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && incoming().uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      
      match /webauthn_credentials/{credId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Legal Repositories (Public Read, Admin Write)
    match /legislation_repository/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Unified Legal Database (Module Alignment)
    match /legalEnactments/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cassationDecisions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /legalAuditLogs/{id} {
      allow read, write: if isAdmin();
    }

    // Telegram & Analytics (Explicit collection matches for feed list/get)
    // Telegram legal repository: sanada maxxanfamee fi qulqullaa'e qofa public dha.
    match /telegram_legal_documents/{docId} {
      allow get, list: if true; // Public read for legal awareness
      allow create, update, delete: if isAdmin() || (request.auth != null && request.auth.token.legalContentManager == true);
    }
    match /telegram_logs/{id} {
      allow read, write: if isAdmin();
    }
    match /telegram_polls/{allPaths=**} {
      allow read, write: if true;
    }
    match /telegram_channels/{allPaths=**} {
      allow read, write: if true;
    }
    match /telegram_posts/{allPaths=**} {
      allow read, write: if true;
    }
    match /telegram_archive/{allPaths=**} {
      allow read, write: if true;
    }
    match /telegram_messages/{allPaths=**} {
      allow read, write: if true;
    }
    match /telegram_channel_feed/{allPaths=**} {
      allow read, write: if true;
    }
    match /telegram_subscribers/{allPaths=**} {
      allow read, write: if true;
    }
    match /telegram_user_stats/{allPaths=**} {
      allow read, write: if true;
    }
    match /telegram_poll_results/{allPaths=**} {
      allow read, write: if true;
    }
    match /telegram_briefing_logs/{allPaths=**} {
      allow read, write: if true;
    }
    match /site_analytics/{docId} {
      allow create: if true;
      allow read: if isAdmin();
    }
    match /legal_ai_audit/{docId} {
      allow create: if true;
      allow read: if isAdmin();
    }

    match /quality_audits/{auditId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isAdmin() || request.auth.token.role in ['chief_judge', 'it_auditor', 'legal_expert']);
      allow update: if isSignedIn() && (isAdmin() || request.auth.token.role in ['chief_judge', 'it_auditor', 'legal_expert']);
      allow delete: if isAdmin();
      
      match /{allPaths=**} {
        allow read, write: if isSignedIn() && (isAdmin() || request.auth.token.role in ['chief_judge', 'it_auditor', 'legal_expert']);
      }
    }

    match /legal_sources/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /legalDocuments/{id} {
      allow read: if true;
      allow write: if isAdmin() || isCourtReporterOrStaff();
      
      match /textChunks/{chunkId} {
        allow read: if true;
        allow write: if isAdmin() || isCourtReporterOrStaff();
      }
      
      match /versions/{versionId} {
        allow read: if true;
        allow write: if isAdmin() || isCourtReporterOrStaff();
      }

      match /reviewHistory/{reviewId} {
        allow read: if true;
        allow write: if isAdmin() || isCourtReporterOrStaff();
      }
    }

    match /cassation_decisions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /witness_schedules/{id} {
      allow read, write: if true;
    }

    match /vector_chunks/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /legal_qna_repository/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /social_legal_repository/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User Content (Scoped to userId)
    match /objection_templates/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isEmailVerified() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /court_sessions/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isEmailVerified() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && existing().userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /annotations/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isEmailVerified() && incoming().userId == request.auth.uid;
      allow update, delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /document_drafts/{id} {
      allow read: if resource.data.isPublic == true || (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.ownerId == request.auth.uid || isAdmin()));
      allow create: if isSignedIn() && (incoming().userId == request.auth.uid || incoming().ownerId == request.auth.uid || isAdmin());
      allow update, delete: if isSignedIn() && (existing().userId == request.auth.uid || existing().ownerId == request.auth.uid || isAdmin());
    }

    match /user_documents/{id} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (incoming().userId == request.auth.uid || incoming().ownerId == request.auth.uid);
      allow update: if isSignedIn() && (existing().userId == request.auth.uid || existing().ownerId == request.auth.uid) && (incoming().userId == existing().userId || incoming().ownerId == existing().ownerId);
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || existing().ownerId == request.auth.uid || isAdmin());
    }

    // Shared Content
    match /shared_drafts/{id} {
      allow read: if isSignedIn() && (resource.data.ownerId == request.auth.uid || (resource.data.sharedWith != null && request.auth.uid in resource.data.sharedWith) || isAdmin());
      allow create: if isSignedIn() && isEmailVerified() && incoming().ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }

    match /shared_folders/{id} {
      allow read: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isEmailVerified() && incoming().ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }

    match /discussions/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn() && (
        existing().authorId == request.auth.uid || 
        existing().userId == request.auth.uid || 
        existing().ownerId == request.auth.uid || 
        isAdmin()
      );
    }

    match /dossier_audits/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isEmailVerified() && incoming().userId == request.auth.uid;
    }

    // Feedback & Analytics
    match /feedback_messages/{id} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    match /analytics_events/{id} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // Payments Isolation
    match /payment_transactions/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isEmailVerified() && isValidPayment(incoming()) && incoming().status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /airtime_requests/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isEmailVerified() && incoming().userId == request.auth.uid;
    }

    // Logs & Audits
    match /audit_logs/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /admin_activity_logs/{id} {
      allow read, write: if isSignedIn() || isAdmin();
    }

    match /admin_activity_logs_archived/{id} {
      allow read, write: if isAdmin();
    }

    match /auth_logs/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // System Config
    match /system_config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Institutional & Courtroom Management Isolation
    match /courtroom_sessions/{id} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }

    match /court_institutions/{id} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.adminUid);
      allow delete: if isAdmin();
    }

    match /court_users/{id} {
      allow read: if isSignedIn() && (
        request.auth.uid == id || 
        isAdmin() || 
        (request.auth.token.institutionId == resource.data.institutionId && request.auth.token.role == 'court_admin')
      );
      
      allow create: if isAdmin() || (
        isSignedIn() && 
        request.auth.token.institutionId == incoming().institutionId &&
        request.auth.token.role == 'court_admin'
      );
      
      allow update: if isAdmin() || (
        isSignedIn() && 
        request.auth.token.institutionId == existing().institutionId &&
        request.auth.token.role == 'court_admin' &&
        incoming().institutionId == existing().institutionId &&
        incoming().role == existing().role
      );
      
      allow delete: if isAdmin();
    }

    match /court_access_requests/{id} {
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    match /test/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /verifications/{id} {
      allow read, write: if isAdmin();
    }

    // Court Cases & Judicial Dockets
    match /cases/{id} {
      allow get, list: if hasCourtRole() && (resource.data.isPublic == true || (request.auth.token.institutionId != null && resource.data.institutionId == request.auth.token.institutionId));
      allow create: if canEditCases() && request.auth.token.institutionId != null && request.resource.data.institutionId == request.auth.token.institutionId;
      allow update: if canEditCases() && request.auth.token.institutionId != null && resource.data.institutionId == request.auth.token.institutionId;
      allow delete: if isAdmin() && request.auth.token.institutionId != null && resource.data.institutionId == request.auth.token.institutionId;

      match /activity_logs/{logId} {
        allow read, write: if isSignedIn() || isCourtReporterOrStaff();
      }

      match /audio_recordings/{recId} {
        allow read, write: if isSignedIn() || isCourtReporterOrStaff();
      }

      match /physical_evidence/{evidenceId} {
        allow read, write: if isSignedIn() || isCourtReporterOrStaff();
      }

      match /witness_statements/{stmtId} {
        allow read, write: if isSignedIn() || isCourtReporterOrStaff();
      }
    }

    match /witness_statements/{stmtId} {
      allow read, write: if isSignedIn() || isCourtReporterOrStaff();
    }

    match /court_audio_recordings/{recId} {
      allow read, write: if isSignedIn() || isCourtReporterOrStaff();
    }

    match /admin_logs/{id} {
      allow read, create: if isSignedIn() || isAdmin();
      allow update, delete: if isAdmin();
    }

    // Court Notifications & Automated 24-Hour Session Alerts
    match /court_notifications/{id} {
      allow read: if isSignedIn() && (resource.data.recipientUid == request.auth.uid || isCourtReporterOrStaff());
      allow create: if isSignedIn() && (incoming().recipientUid == request.auth.uid || isCourtReporterOrStaff());
      allow update: if isSignedIn() && (existing().recipientUid == request.auth.uid || isCourtReporterOrStaff());
      allow delete: if isAdmin();
    }

    // Court Document Templates (Scoped by institutionId)
    match /court_templates/{id} {
      allow read: if true;
      allow write: if isSignedIn() || isCourtReporterOrStaff();
    }

    // Simulation / Practice Cases
    match /practice_cases/{caseId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isCourtReporterOrStaff());
      allow create: if isSignedIn() && (incoming().userId == request.auth.uid || isCourtReporterOrStaff());
      allow update, delete: if isSignedIn() && (existing().userId == request.auth.uid || isCourtReporterOrStaff());
    }

    // Collaboration Invites
    match /collaboration_invites/{id} {
      allow read, write: if isSignedIn() || isAdmin();
    }

    // Vector Feedback
    match /vector_feedback/{id} {
      allow create: if isSignedIn();
      allow read, write: if isAdmin();
    }

    // AI Legal Inaccuracy & User Feedback Reports
    match /user_feedback/{id} {
      allow create: if true;
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /institutions/{institutionId} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
      
      match /courtDocuments/{docId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if isAdmin() || isSignedIn();
      }

      match /auditLogs/{logId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isAdmin();
      }
    }

    match /court_documents/{docId} {
      allow read: if isSignedIn() && (
        request.auth.token.institutionId == resource.data.institutionId ||
        isAdmin() || resource.data.isPublic == true
      );
      allow create: if isSignedIn() && (
        request.auth.token.institutionId == request.resource.data.institutionId || isAdmin()
      );
      allow update, delete: if isSignedIn() && (
        request.auth.token.institutionId == resource.data.institutionId || isAdmin()
      );
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
